{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "declaration": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    // Lets the examples import the package by the name a user would type, while still
    // being checked against the source in this repository.
    "baseUrl": ".",
    "paths": {
      "@caerus-dev/sdk": ["./src/index.ts"]
    }
  },
  "include": ["src", "test", "examples"],
  "exclude": ["node_modules", "dist"]
}
