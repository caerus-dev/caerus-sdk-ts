{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "declaration": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    // Lets the examples import the package by the name a user would type, while still
    // being checked against the source in this repository.
    //
    // No baseUrl: since TypeScript 4.4 a relative path here resolves against this file,
    // and setting one only brings the deprecation warning along.
    "paths": {
      "@caerus-dev/sdk": ["./src/index.ts"]
    }
  },
  "include": ["src", "test", "examples"],
  "exclude": ["node_modules", "dist"]
}
